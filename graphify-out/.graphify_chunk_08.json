    { "id": "vetotoasthost_scheduledischard", "label": "VetoToastHost.ScheduleDiscard", "file_type": "code", "source_file": "Veto/Components/Toast/VetoToastHost.razor.cs", "source_location": "L337-348", "source_url": null, "captured_at": null, "author": null, "contributor": null },
    { "id": "vetotoasthost_discardasync", "label": "VetoToastHost.DiscardAsync", "file_type": "code", "source_file": "Veto/Components/Toast/VetoToastHost.razor.cs", "source_location": "L350-374", "source_url": null, "captured_at": null, "author": null, "contributor": null },
    { "id": "vetotoasthost_dismiss", "label": "VetoToastHost.Dismiss", "file_type": "code", "source_file": "Veto/Components/Toast/VetoToastHost.razor.cs", "source_location": "L301", "source_url": null, "captured_at": null, "author": null, "contributor": null },
    { "id": "toastsubsystem_service_owns_list_host_owns_clock", "label": "Service owns the list, host owns the clock", "file_type": "rationale", "source_file": "Veto/Components/Toast/VetoToastService.cs", "source_location": "L7-18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The service deliberately knows nothing about timing or animation: it does not start auto-dismiss timers because the caller's Duration may be null and only the host knows what null means, and it does not remove a leaving toast because only the host knows how long the exit animation runs. This division lets the host resolve host-level defaults centrally while the service stays a pure data/policy store." },
    { "id": "toastsubsystem_duplicate_handling_policy", "label": "Toast duplicate handling policy", "file_type": "rationale", "source_file": "Veto/Components/Toast/VetoToastEnums.cs", "source_location": "L89-105", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Allow (default) always shows a new toast; Block drops a repeat and leaves the existing toast untouched, for when a repeat means nothing new happened; Replace drops the new one but folds it into the existing toast, incrementing Count and restarting its timer, for when the repeat itself is the information the user should see." },
    { "id": "toastsubsystem_max_toasts_eviction", "label": "Max-toasts eviction rule", "file_type": "rationale", "source_file": "Veto/Components/Toast/VetoToastService.cs", "source_location": "L86-96", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When the live (non-leaving) toast count reaches MaxToasts, the oldest non-sticky toasts are retired to make room. Sticky toasts are exempt because they are on screen precisely because they must not disappear on their own." },
    { "id": "toastsubsystem_countdown_mechanism", "label": "Tick-driven pausable countdown", "file_type": "rationale", "source_file": "Veto/Components/Toast/VetoToastHost.razor.cs", "source_location": "L303-335", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The timer is ticked in 100ms increments (TickMilliseconds) rather than awaited as one Task.Delay, so hovering can pause the countdown (toast.Paused) without cancelling it. The CSS progress bar pauses the same way via a CSS custom property, keeping the visual bar and the actual dismiss timer in step." },
    { "id": "toastsubsystem_deduplicationkey", "label": "VetoToastMessage.DeduplicationKey", "file_type": "code", "source_file": "Veto/Components/Toast/VetoToastMessage.cs", "source_location": "L50-51", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Falls back to a composite of type, title and message when the caller supplies no explicit DeduplicationKey, so unrelated toasts with the same wording but different severity are not treated as duplicates." },
    { "id": "vetocore_vetocomponentbase", "label": "VetoComponentBase", "file_type": "code", "source_file": "Veto/Components/Toast/VetoToastHost.razor.cs", "source_location": "L30", "source_url": null, "captured_at": null, "author": null, "contributor": null },
