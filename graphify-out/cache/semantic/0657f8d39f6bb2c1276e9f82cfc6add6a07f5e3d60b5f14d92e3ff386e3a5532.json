{"nodes": [{"id": "vetocomponentcore_class", "label": "VetoComponentCore", "file_type": "code", "source_file": "Veto/Core/VetoComponentCore.cs", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Veto has two base classes (VetoComponentBase and VetoInputBase<TValue>) because a form component must inherit Blazor's InputBase<T> for @bind-Value, EditContext and validation, and C# allows only one base class. Rather than duplicate shared behaviour, both hold a VetoComponentCore instance and delegate to it, so id generation, class building, style building and attribute filtering exist in exactly one place."}, {"id": "vetocomponentcore_resolveid", "label": "VetoComponentCore.ResolveId", "file_type": "code", "source_file": "Veto/Core/VetoComponentCore.cs", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "vetocomponentbase_class", "label": "VetoComponentBase", "file_type": "code", "source_file": "Veto/Core/VetoComponentCore.cs", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "vetocomponentbase_class", "target": "vetocomponentcore_class", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Veto/Core/VetoComponentCore.cs", "source_location": null, "weight": 1.0}, {"source": "vetocomponentcore_resolveid", "target": "vetotheme_record", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.55, "source_file": "Veto/Core/VetoComponentCore.cs", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "dual_base_class_delegation", "label": "Dual-base-class delegation to shared core implementations", "nodes": ["vetocomponentbase_class", "vetoinputbase_class", "vetocomponentcore_class", "vetoeffects_struct"], "relation": "implement", "confidence": "EXTRACTED", "confidence_score": 0.95, "source_f