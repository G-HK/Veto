o; the PGlite table is read only when the mirror was never written."}], "edges": [{"source": "veto_gantt_store_js_open", "target": "veto_gantt_store_js_start", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Veto/wwwroot/veto-gantt-store.js", "source_location": "34", "weight": 1.0}, {"source": "veto_gantt_store_js_start", "target": "veto_gantt_store_js_mirror_pattern", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Veto/wwwroot/veto-gantt-store.js", "source_location": "38", "weight": 1.0}, {"source": "veto_gantt_store_js_load", "target": "veto_gantt_store_js_mirror_pattern", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Veto/wwwroot/veto-gantt-store.js", "source_location": "80", "weight": 1.0}, {"source": "veto_gantt_store_js_save", "target": "veto_gantt_store_js_load", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Veto/wwwroot/veto-gantt-store.js", "source_location": "115", "weight": 1.0}, {"source": "veto_gantt_store_js_clear", "target": "veto_gantt_store_js_mirror_pattern", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Veto/wwwroot/veto-gantt-store.js", "source_location": "130", "weight": 1.0}], "hyperedges": [{"id": "gantt_edit_persistence_flow", "label": "Gantt bar drag edit persisted through mirrored storage", "nodes": ["veto_gantt_drag_js_onbardragged", "veto_gantt_store_js_save", "veto_gantt_store_js_mirror_pattern", "veto_gantt_store_js_load"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "Veto/wwwroot/veto-gantt-store.js"}]}