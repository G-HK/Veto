{"nodes": [{"id": "contributing_component_contract", "label": "Veto Component Contract (Class/Style/Id/TestId/Visible/AdditionalAttributes)", "file_type": "rationale", "source_file": "Veto/docs/Contributing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Id auto-generates so for/aria-* never dangle; Class/Style append after the component's own so the consumer always wins; every component exposes the same surface regardless of base class."}, {"id": "contributing_vetotextbox_reference", "label": "VetoTextBox (Reference Implementation)", "file_type": "code", "source_file": "Veto/docs/Contributing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "contributing_vetoinputbase", "label": "VetoInputBase<TValue>", "file_type": "code", "source_file": "Veto/docs/Contributing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inherits Blazor's InputBase<TValue> to get @bind-Value, ValueExpression, EditContext and FieldIdentifier for free rather than hand-rolling two-way binding."}, {"id": "contributing_vetocomponentbase", "label": "VetoComponentBase", "file_type": "code", "source_file": "Veto/docs/Contributing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "contributing_vetocomponentcore", "label": "VetoComponentCore", "file_type": "code", "source_file": "Veto/docs/Contributing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single implementation both base classes delegate to, so shared behaviour is written once - contract additions go here, not duplicated in both bases."}, {"id": "contributing_ivetocomponent", "label": "IVetoComponent", "file_type": "code", "source_file": "Veto/docs/Contributing.md", "source_location": null, "sou