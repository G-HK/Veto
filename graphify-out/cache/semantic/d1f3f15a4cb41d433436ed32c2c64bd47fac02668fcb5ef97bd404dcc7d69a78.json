{"nodes": [{"id": "vetodock_component", "label": "VetoDock", "file_type": "code", "source_file": "Veto/Layouts/Dock/VetoDock.razor.cs", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Magnification needs the pointer's continuous position rather than merely which item is hovered, so it is computed in JavaScript (veto-dock.js) and applied through a custom property; dropped entirely under reduced motion and for coarse pointers. VetoDockAppearance.Magnified mirrors the macOS dock; Flat mirrors the Windows taskbar. Position, auto-hide and keyboard handling are shared across appearances."}, {"id": "vetodockappearance_enum", "label": "VetoDockAppearance", "file_type": "code", "source_file": "Veto/Layouts/Dock/VetoDock.razor.cs", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "veto_dock_js", "label": "veto-dock.js (JS module)", "file_type": "code", "source_file": "Veto/Layouts/Dock/VetoDock.razor.cs", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "vetodock_component", "target": "vetodockappearance_enum", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Veto/Layouts/Dock/VetoDock.razor.cs", "source_location": null, "weight": 1.0}, {"source": "vetodock_component", "target": "veto_dock_js", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Veto/Layouts/Dock/VetoDock.razor.cs", "source_location": null, "weight": 1.0}], "hyperedges": []}