@namespace Veto.Layouts.DockLayout
@inherits Veto.Core.VetoComponentBase
@using Veto.Layouts.Dock

@if (Visible)
{
    <div @ref="RootElement" @attributes="InnerAttributes" id="@ElementId" 
         class="@CssClass" style="@CssStyle" data-testid="@TestId">
        
        @if (Wallpaper is not null)
        {
            <div class="veto-dock-layout__wallpaper" aria-hidden="true">@Wallpaper</div>
        }

        <main class="veto-dock-layout__surface">
            @ChildContent
        </main>

        <VetoDock Position="Position" Appearance="Appearance" AutoHide="AutoHide"
                  Magnification="Magnification" ItemSize="@ItemSize" Label="@DockLabel"
                  TestId="@(TestId is null ? null : $"{TestId}-dock")">
            @Items
        </VetoDock>
    </div>
}