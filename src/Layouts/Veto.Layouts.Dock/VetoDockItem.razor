@namespace Veto.Layouts.Dock
@inherits Veto.Core.VetoComponentBase
@implements IDisposable
@using Veto.Components.Icon

@if (Visible)
{
    @if (Href is not null)
    {
        <a @ref="RootElement"
           @attributes="InnerAttributes"
           id="@ElementId"
           class="@CssClass"
           style="@CssStyle"
           data-testid="@TestId"
           href="@Href"
           target="@Target"
           tabindex="@TabIndex"
           aria-label="@Label"
           aria-current="@(IsActive ? "page" : null)">
            @RenderContents()
        </a>
    }
    else
    {
        <button @ref="RootElement"
                @attributes="InnerAttributes"
                id="@ElementId"
                class="@CssClass"
                style="@CssStyle"
                data-testid="@TestId"
                type="button"
                tabindex="@TabIndex"
                disabled="@Disabled"
                aria-label="@Label"
                aria-pressed="@(IsActive ? "true" : null)"
                @onclick="OnClick">
            @RenderContents()
        </button>
    }
}

@code {
    private RenderFragment RenderContents () =>
        @<text>
            <span class="veto-dock__icon">
                @if (ChildContent is not null)
                {
                    @ChildContent
                }
                else
                {
                    <VetoIcon Icon="@Icon" Size="VetoIconSize.Inherit" />
                }
            </span>

            <span class="veto-dock__tooltip" aria-hidden="true">@Label</span>

            @if (Badge is not null)
            {
                <span class="veto-dock__badge" aria-hidden="true">@Badge</span>
            }

            @if (ShowIndicator)
            {
                <span class="veto-dock__indicator" aria-hidden="true"></span>
            }
        </text>;
}
