@namespace Veto.Components.Gantt
@inherits Veto.Core.VetoComponentBase
@implements IAsyncDisposable
@using System.Globalization
@using Veto.Components.Buttons
@using Veto.Components.Icon
@using Veto.Components.Menu
@using Veto.Components.TextBox
@inject IJSRuntime JS

@if (Visible)
{
    <div @ref="RootElement" @attributes="InnerAttributes" id="@ElementId" class="@CssClass"
         style="@CssStyle" data-testid="@TestId" data-store="@(PersistKey is null ? null : StoreBackend)"
         data-draggable="@(Editable ? (DragHandleAttached ? "true" : "false") : null)">

        @if (ShowToolbar)
        {
            <div class="veto-gantt__toolbar" data-testid="@Sub("toolbar")">
                @if (ShowSearch)
                {
                    <div class="veto-gantt__search">
                        <VetoTextBox TValue="string" TestId="@Sub("search")" Placeholder="Filter tasks"
                                     Size="VetoSize.Small" Immediate="true" Value="Search"
                                     ValueChanged="OnSearchChangedAsync" ValueExpression="() => Search" />
                    </div>
                }

                @if (ShowCategoryFilter && Categories.Count > 0)
                {
                    <div class="veto-gantt__filters" role="group" aria-label="Filter by category">
                        @foreach (var category in Categories)
                        {
                            <button type="button" class="veto-gantt__chip veto-gantt__chip--category @(IsCategoryOn(category.Name) ? "veto-gantt__chip--on" : null)"
                                    style="@CategoryStyle(category)" data-testid="@Sub($"category-{Slug(category.Name)}")" aria-pressed="@(IsCategoryOn(category.Name) ? "true" : "false")"
                                    @onclick="() => ToggleCategoryAsync(category.Name)"> 
                                <span class="veto-gantt__swatch" aria-hidden="true"></span>
                                @category.Name
                            </button>
                        }
                    </div>
                }

                @if (ShowViewPicker)
                {
                    <div class="veto-gantt__scales" role="group" aria-label="View">
                        @foreach (var option in ViewOptions)
                        {
                            <button type="button" class="veto-gantt__chip @(View == option ? "veto-gantt__chip--on" : null)"
                                    data-testid="@Sub($"view-{option.ToString().ToLowerInvariant()}")" aria-pressed="@(View == option ? "true" : "false")"
                                    @onclick="() => SetViewAsync(option)">
                                @option
                            </button>
                        }
                    </div>
                }

                @if (ShowFilters && Filters.Count > 0)
                {
                    <div class="veto-gantt__filters" role="group" aria-label="Filters">
                        @foreach (var filter in Filters)
                        {
                            <button type="button" class="veto-gantt__chip veto-gantt__chip--filter @(IsFilterOn(filter.Id) ? "veto-gantt__chip--on" : null)"
                                    title="@filter.Tooltip" data-testid="@Sub($"filter-{Slug(filter.Id)}")"
                                    aria-pressed="@(IsFilterOn(filter.Id) ? "true" : "false")"
                                    @onclick="() => ToggleFilterAsync(filter.Id)">
                                @if (filter.Icon is not null)
                                {
                                    <VetoIcon Icon="@filter.Icon" />
                                }
                                @filter.Label
                            </button>
                        }
                    </div>
                }

                @* One option is no choice, so a chart held to a single scale shows no picker. *@
                @if (ShowScalePicker && View == VetoGanttView.Schedule && Scales.Count > 1)
                {
                    <div class="veto-gantt__scales" role="group" aria-label="Time scale">
                        @foreach (var option in Scales)
                        {
                            <button type="button" class="veto-gantt__chip @(Scale == option ? "veto-gantt__chip--on" : null)"
                                    data-testid="@Sub($"scale-{option.ToModifier()}")" aria-pressed="@(Scale == option ? "true" : "false")"
                                    @onclick="() => SetScaleAsync(option)">
                                @option.ToLabel()
                            </button>
                        }
                    </div>
                }

                @* The trailing cluster. Time navigation, export and reset act on the chart as a
                   whole, where the filters and the scale change what it shows - so they are
                   grouped together and pushed to the trailing edge, behind a hairline. *@
                <div class="veto-gantt__actions" data-testid="@Sub("actions")">
                    @if (ShowNavigation)
                    {
                        <div class="veto-gantt__nav" role="group" aria-label="Move through time">
                            <VetoIconButton Icon="@VetoIcons.ChevronLeft" Label="Earlier" Size="VetoSize.Small" TestId="@Sub("previous")"
                                            OnClick="() => ScrollByAsync(-1)" />
                            <VetoButton Size="VetoSize.Small" Variant="VetoVariant.Text" Color="VetoColor.Neutral"
                                        TestId="@Sub("today")" OnClick="ScrollToTodayAsync">
                                Today
                            </VetoButton>
                            <VetoIconButton Icon="@VetoIcons.ChevronRight"
                                            Label="Later"
                                            Size="VetoSize.Small"
                                            TestId="@Sub("next")"
                                            OnClick="() => ScrollByAsync(1)" />
                        </div>
                    }

                    @if (Exportable && ExportFormats.Count > 0)
                    {
                        @* One control instead of a button per format: the toolbar is already full
                           of filters and scales, and export is the thing a reader wants least
                           often. *@
                        <VetoMenu TestId="@Sub("export")" Label="@(ShowExportLabel ? "Export" : null)"
                                  Tooltip="Export" Icon="@VetoIcons.Download" Size="VetoSize.Small"
                                  Variant="VetoVariant.Outlined" Color="VetoColor.Neutral"
                                  OpenOn="ExportOpenOn" Placement="ExportPlacement" 
                                  Appearance="ExportAppearance">
                            <VetoMenuLabel Text="Export as" />
                            @foreach (var format in ExportFormats)
                            {
                                @if (format == VetoGanttExportFormat.Csv)
                                {
                                    <VetoMenuItem Icon="@VetoIcons.Csv" Text="CSV" Tooltip="Export as CSV"
                                                  TestId="@Sub("export-csv")" OnClick="() => ExportAsync(VetoGanttExportFormat.Csv)" />
                                }
                                else
                                {
                                    <VetoMenuItem Icon="@VetoIcons.Json" Text="JSON" Tooltip="Export as JSON"
                                                  TestId="@Sub("export-json")" OnClick="() => ExportAsync(VetoGanttExportFormat.Json)" />
                                }
                            }
                        </VetoMenu>
                    }

                    @if (ShowResetButton && PersistKey is not null && HasEdits)
                    {
                        <VetoButton Size="VetoSize.Small" Variant="VetoVariant.Outlined" Color="VetoColor.Danger"
                                    StartIcon="@VetoIcons.Trash" TestId="@Sub("reset")" OnClick="ResetAsync">
                            Reset my changes
                        </VetoButton>
                    }
                </div>

                @Toolbar
            </div>
        }

        @if (Loading)
        {
            <div class="veto-gantt__frame veto-gantt__frame--loading" style="@FrameStyle"
                 role="status" aria-busy="true" aria-label="@LoadingText" data-testid="@Sub("skeleton")">
                <div class="veto-gantt__sidebar">
                    <div class="veto-gantt__sidebar-head">@SidebarTitle</div>
                    @for (var row = 0; row < LoadingRows; row++)
                    {
                        <div class="veto-gantt__row veto-gantt__row--label">
                            <VetoSkeleton Width="@SkeletonNameWidth(row)" />
                        </div>
                    }
                </div>

                <div class="veto-gantt__scroller">
                    <div class="veto-gantt__skeleton-head">
                        <VetoSkeleton Width="9rem" />
                    </div>
                    @for (var row = 0; row < LoadingRows; row++)
                    {
                        <div class="veto-gantt__row">
                            @* Offset and width vary per row, so the placeholder reads as a
                               schedule rather than a stack of identical blocks. *@
                            <VetoSkeleton Variant="VetoSkeletonVariant.Rectangle" Class="veto-gantt__skeleton-bar"
                                          Style="@SkeletonBarStyle(row)" /> 
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <VetoLoadingOverlay Loading="Refreshing" Label="@LoadingText" TestId="@Sub("refresh")">
            <div class="veto-gantt__frame" style="@FrameStyle">
                <div class="veto-gantt__sidebar" data-testid="@Sub("sidebar")">
                    <div class="veto-gantt__sidebar-head">@SidebarTitle</div>

                    @foreach (var row in Rows)
                    {
                        <div class="veto-gantt__row veto-gantt__row--label @(IsSelected(row.Item) ? "veto-gantt__row--selected" : null)"
                             style="@($"--veto-gantt-depth: {row.Depth}; {RowHeightStyle(row)}")" data-testid="@Sub($"label-{row.Item.Id}")">
                            @if (row.HasChildren && Collapsible)
                            {
                                <button type="button" class="veto-gantt__twisty"
                                        aria-expanded="@(IsExpanded(row.Item.Id) ? "true" : "false")"
                                        aria-label="@($"Toggle {row.Item.Name}")"
                                        data-testid="@Sub($"twisty-{row.Item.Id}")"
                                        @onclick="() => ToggleGroup(row.Item.Id)">
                                    <VetoIcon Icon="@VetoIcons.ChevronDown" Rotation="@(IsExpanded(row.Item.Id) ? 0 : -90)" />
                                </button>
                            }
                            else
                            {
                                <span class="veto-gantt__twisty veto-gantt__twisty--empty"></span>
                            }

                            <span class="veto-gantt__name" title="@row.Item.Name">@row.Item.Name</span>

                            @if (ShowDates)
                            {
                                <span class="veto-gantt__dates">@FormatRange(row.Item)</span>
                            }
                        </div>
                    }

                    @if (Rows.Count == 0)
                    {
                        <div class="veto-gantt__empty" data-testid="@Sub("empty")">@EmptyText</div>
                    }
                </div>

                <div @ref="_scroller" class="veto-gantt__scroller" data-testid="@Sub("scroller")">
                    <div class="veto-gantt__canvas" style="@($"width: {Timeline.Width.ToString("0.##", CultureInfo.InvariantCulture)}px")">

                        <div class="veto-gantt__head">
                            <div class="veto-gantt__head-row veto-gantt__head-row--groups">
                                @foreach (var group in Timeline.Groups)
                                {
                                    <span class="veto-gantt__head-cell" style="@CellStyle(group)">@group.Label</span>
                                }
                            </div>
                            <div class="veto-gantt__head-row">
                                @foreach (var column in Timeline.Columns)
                                {
                                    <span class="veto-gantt__head-cell @(column.IsWeekend ? "veto-gantt__head-cell--weekend" : null)"
                                          style="@CellStyle(column)">@column.Label</span>
                                }
                            </div>
                        </div>

                        <div @ref="_grid" class="veto-gantt__grid">
                            @if (ShowWeekends && Scale == VetoGanttScale.Day)
                            {
                                @foreach (var column in Timeline.Columns.Where(c => c.IsWeekend))
                                {
                                    <span class="veto-gantt__weekend" style="@CellStyle(column)" aria-hidden="true"></span>
                                }
                            }

                            @if (ShowToday && TodayMarkerOffset is { } todayOffset)
                            {
                                <span class="veto-gantt__today"
                                      style="@($"left: {todayOffset.ToString("0.##", CultureInfo.InvariantCulture)}px")"
                                      data-testid="@Sub("today-marker")" aria-hidden="true"></span>
                            }

                            @if (ShowDependencies && Links.Count > 0)
                            {
                                @* Drawn above the rows but below the bars, and transparent to the
                                   pointer, so an arrow never intercepts a click meant for a bar. *@
                                <svg class="veto-gantt__links"
                                     width="@Timeline.Width.ToString("0.##", CultureInfo.InvariantCulture)"
                                     height="@LinkLayerHeight.ToString("0.##", CultureInfo.InvariantCulture)"
                                     data-testid="@Sub("links")"
                                     aria-hidden="true"
                                     focusable="false">
                                    <defs>
                                        <marker id="@($"{ElementId}-arrow")"
                                                viewBox="0 0 8 8"
                                                refX="7" refY="4"
                                                markerWidth="6" markerHeight="6"
                                                orient="auto-start-reverse">
                                            <path d="M 0 1 L 7 4 L 0 7 z" fill="context-stroke" />
                                        </marker>
                                    </defs>

                                    @foreach (var link in Links)
                                    {
                                        <path class="veto-gantt__link @(IsLinkActive(link) ? "veto-gantt__link--active" : null)"
                                              d="@LinkPath(link)" marker-end="@($"url(#{ElementId}-arrow)")"
                                              data-testid="@Sub($"link-{link.FromId}-{link.ToId}")" />
                                    }
                                </svg>
                            }

                            @foreach (var row in Rows)
                            {
                                <div class="veto-gantt__row @(IsSelected(row.Item) || row.Inline.Any(IsSelected) ? "veto-gantt__row--selected" : null)"
                                     style="@RowHeightStyle(row)" data-lanes="@(row.Lanes > 1 ? row.Lanes : null)"
                                     data-testid="@Sub($"row-{row.Item.Id}")">
                                    @if (row.Inline.Count > 0)
                                    {
                                        @* A folded parent in the inline layout: its sub-items take
                                           its line, each a bar of its own, instead of the summary
                                           bar that would cover them all. *@
                                        @foreach (var item in row.Inline)
                                        {
                                            @Bar(item, isSummary: false, isInline: true, row.LaneOf(item), row.Lanes)
                                        }
                                    }
                                    else
                                    {
                                        @Bar(row.Item, row.HasChildren, isInline: false, lane: 0, lanes: 1)
                                    }
                                </div>
                            }

                            @if (Hovered is var (hoveredItem, hoveredIndex))
                            {
                                @* One card for the whole chart, placed against its row, rather than
                                   one per bar: a bar clips its own overflow, so a card inside it
                                   would be cut off at the bar's edge. *@
                                <div id="@($"{ElementId}-tooltip")" class="veto-gantt__tooltip" role="tooltip"
                                     style="@TooltipStyle(hoveredItem, hoveredIndex)"
                                     data-testid="@Sub("tooltip")">
                                    @TooltipTemplate!(hoveredItem)
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            </VetoLoadingOverlay>
        }
    </div>
}

@code {
    /// <summary>
    /// One bar or milestone. Shared by a row's own bar and by the sub-items an inline parent
    /// draws on its line, so the two can never drift apart in what they show or respond to.
    /// </summary>
    private RenderFragment Bar ( VetoGanttItem item, bool isSummary, bool isInline, int lane, int lanes ) =>
        @<text>
            @* Work entirely outside the axis draws nothing, rather than a stub pinned to the
               edge that would read as a one-day task. *@
            @if (!Timeline.Overlaps(item.StartsAt, item.EndsAt))
            {
            }
            else if (item.IsMilestone)
            {
                <button type="button" class="veto-gantt__milestone @(isInline ? "veto-gantt__milestone--inline" : null)" style="@BarStyle(item, lane, lanes)"
                        title="@NativeTooltipFor(item)" aria-label="@TooltipFor(item)"
                        data-testid="@Sub($"bar-{item.Id}")" @onclick="() => SelectAsync(item)"
                        @attributes="TooltipHandlers(item)">
                </button>
            }
            else
            {
                <button type="button"
                        class="veto-gantt__bar @(isSummary ? "veto-gantt__bar--summary" : null) @(isInline ? "veto-gantt__bar--inline" : null) @(IsSelected(item) && isInline ? "veto-gantt__bar--selected" : null) @(IsEditable(item, isSummary) ? "veto-gantt__bar--editable" : null)"
                        style="@BarStyle(item, lane, lanes)" title="@NativeTooltipFor(item)" aria-label="@TooltipFor(item)"
                        data-testid="@Sub($"bar-{item.Id}")" data-editable="@(IsEditable(item, isSummary) ? "true" : null)"
                        data-row-id="@item.Id" @onclick="() => SelectAsync(item)"
                        @onkeydown="args => OnBarKeyDownAsync(args, item)"
                        @attributes="TooltipHandlers(item)">
                    @if (ShowProgress && item.Progress is { } progress)
                    {
                        @* The washed-out part is what is left to do: the solid part reads as
                           done, and the label keeps its contrast against the bar's full colour. *@
                        <span class="veto-gantt__remaining"
                              style="@($"width: {((1 - Math.Clamp(progress, 0, 1)) * 100).ToString("0.##", CultureInfo.InvariantCulture)}%")"
                              aria-hidden="true">
                        </span>
                    }

                    @if (ShowBarLabels)
                    {
                        <span class="veto-gantt__bar-label">
                            @item.Name
                        </span>
                    }
                </button>
            }
        </text>;
}