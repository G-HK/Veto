@namespace Veto.Components.Menu
@inherits Veto.Core.VetoComponentBase
@implements IDisposable
@using Veto.Components.Icon

@if (Visible)
{
    @if (Href is not null && !Disabled)
    {
        <a @ref="RootElement" @attributes="InnerAttributes" id="@ElementId" class="@CssClass"
           style="@CssStyle" data-testid="@TestId" role="menuitem" tabindex="-1"
           href="@Href" target="@Target" rel="@Rel" title="@TooltipText"
           aria-label="@AccessibleName"
           @onclick="ChooseAsync">
            @RenderContents()
        </a>
    }
    else
    {
        <button @ref="RootElement" @attributes="InnerAttributes" id="@ElementId" class="@CssClass"
                style="@CssStyle" data-testid="@TestId" type="button" tabindex="-1"
                role="@(Checked.HasValue ? "menuitemcheckbox" : "menuitem")"
                disabled="@Disabled" title="@TooltipText"
                aria-label="@AccessibleName"
                aria-checked="@(Checked?.ToString().ToLowerInvariant())"
                aria-disabled="@(Disabled ? "true" : null)"
                @onclick="ChooseAsync">
            @RenderContents()
        </button>
    }
}

@code {
    private RenderFragment RenderContents () =>
        @<text>
            @* A checkable item keeps its tick column whether or not it is ticked, so the items
               under it do not shuffle sideways as the reader toggles one. The tick is markup
               rather than a CSS-drawn shape, so it takes its colour from the theme like every
               other icon. *@
            @if (Checked.HasValue)
            {
                <span class="veto-menu-item__check" aria-hidden="true">
                    @if (Checked == true)
                    {
                        <VetoIcon Icon="@VetoIcons.Check" Size="VetoIconSize.Inherit" />
                    }
                </span>
            }

            @if (ShowIcon)
            {
                <span class="veto-menu-item__icon" aria-hidden="true">
                    @if (IconContent is not null)
                    {
                        @IconContent
                    }
                    else if (Icon is not null)
                    {
                        <VetoIcon Icon="@Icon" Size="VetoIconSize.Inherit" />
                    }
                </span>
            }

            @if (ShowText)
            {
                <span class="veto-menu-item__text">
                    @if (ChildContent is not null)
                    {
                        @ChildContent
                    }
                    else
                    {
                        @Text
                    }
                </span>

                @if (Shortcut is not null)
                {
                    <span class="veto-menu-item__shortcut" aria-hidden="true">@Shortcut</span>
                }
            }
        </text>;
}