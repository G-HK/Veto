@namespace Veto.Components.Buttons
@inherits Veto.Core.VetoComponentBase
@using Veto.Components.Icon

@if (Visible)
{
    @if (Href is not null && !Disabled)
    {
        <a @ref="RootElement" @attributes="InnerAttributes" id="@ElementId" class="@CssClass"
           style="@CssStyle" data-testid="@TestId" href="@Href" target="@Target" rel="@ResolvedRel"
           aria-busy="@(IsLoading ? "true" : null)"
           @onclick="OnClickAsync"
           @oncontextmenu="OpenContextMenu" @oncontextmenu:preventDefault="HasContextMenu">
            @RenderContents()
        </a>
    }
    else
    {
        <button @ref="RootElement" @attributes="InnerAttributes"  id="@ElementId" class="@CssClass"
                style="@CssStyle" data-testid="@TestId" type="@Type" disabled="@(Disabled || IsLoading)"
                aria-busy="@(IsLoading ? "true" : null)"
                @onclick="OnClickAsync"
                @oncontextmenu="OpenContextMenu" @oncontextmenu:preventDefault="HasContextMenu">
            @RenderContents()
        </button>
    }

    @if (ContextMenu is not null)
    {
        <VetoContextMenu @ref="_contextMenu" TestId="@(TestId is null ? null : $"{TestId}-context-menu")"
                         Label="@ContextMenuLabel">
            @ContextMenu
        </VetoContextMenu>
    }
}

@code {
    private RenderFragment RenderContents () =>
        @<text>
            @if (IsLoading)
            {
                <VetoIcon Icon="@VetoIcons.Settings" Spin="true" Size="VetoIconSize.Inherit" Class="veto-button__spinner" />
            }
            else if (StartIcon is not null)
            {
                <VetoIcon Icon="@StartIcon" Size="VetoIconSize.Inherit" Class="veto-button__icon" />
            }

            <span class="veto-button__label">@ChildContent</span>

            @if (!IsLoading && EndIcon is not null)
            {
                <VetoIcon Icon="@EndIcon" Size="VetoIconSize.Inherit" Class="veto-button__icon" />
            }
        </text>;
}