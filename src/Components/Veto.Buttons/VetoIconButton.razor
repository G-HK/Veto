@namespace Veto.Components.Buttons
@inherits Veto.Core.VetoComponentBase
@using Veto.Components.Icon

@if (Visible)
{
    @* A disabled link is a disabled button: an anchor has no disabled state, and one that
       still navigates is not disabled at all. *@
    @if (Href is not null && !Disabled)
    {
        <a @ref="RootElement" @attributes="InnerAttributes" id="@ElementId" class="@CssClass"
           style="@CssStyle" data-testid="@TestId" href="@Href" target="@Target" rel="@ResolvedRel"
           title="@Label" aria-label="@Label" @onclick="OnClick">
            <VetoIcon Icon="@Icon" Size="@IconSize" ChildContent="@ChildContent" />
        </a>
    }
    else
    {
        <button @ref="RootElement" @attributes="InnerAttributes" id="@ElementId" class="@CssClass"
                style="@CssStyle" data-testid="@TestId" type="@Type" disabled="@Disabled" 
                title="@Label" aria-label="@Label" aria-pressed="@(Pressed?.ToString().ToLowerInvariant())"
                @onclick="OnClick">
            <VetoIcon Icon="@Icon" Size="@IconSize" ChildContent="@ChildContent" />
        </button>
    }
}