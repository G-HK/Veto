@namespace Veto.Components.TerminalBox
@inherits Veto.Core.VetoComponentBase

@if (Visible)
{
    <div @ref="RootElement" @attributes="InnerAttributes" id="@ElementId"
         class="@CssClass" style="@CssStyle" data-testid="@TestId">

        @if (PromptContent is not null)
        {
            @* Content rather than a sign: an icon, a host name, whatever the prompt is being
               used to say. Not hidden from assistive technology - unlike a bare $, content
               put here deliberately is presumed to be worth reading. *@
            <span class="veto-terminal-line__prompt">@PromptContent</span>
        }
        else if (PromptEditable)
        {
            @* Focusable, so it must not be aria-hidden: hiding a focusable element from the
               accessibility tree leaves a keyboard user on a control their screen reader will
               not announce. It gets a real label instead. *@
            <input class="veto-terminal-line__prompt veto-terminal-line__prompt--editable"
                   type="text" value="@Prompt" size="@PromptSize"
                   aria-label="@PromptLabel"
                   data-testid="@(TestId is null ? null : $"{TestId}-prompt")"
                   @onchange="OnPromptChangedAsync" />
        }
        else if (Prompt is not null)
        {
            <span class="veto-terminal-line__prompt" aria-hidden="true">@Prompt</span>
        }

        @if (Command is not null)
        {
            @* data-terminal-command is what the window's copy button collects. *@
            <span class="veto-terminal-line__command" data-terminal-command>
                <span class="veto-terminal-line__text" data-command="@Command">@Command</span>
            </span>
        }

        @if (Output is not null)
        {
            <span class="veto-terminal-line__output">@Output</span>
        }

        @ChildContent
    </div>
}