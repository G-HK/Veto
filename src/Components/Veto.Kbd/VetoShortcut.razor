@namespace Veto.Components.Kbd
@inherits Veto.Core.VetoComponentBase

@if (Visible)
{
    <div @ref="RootElement"
         @attributes="InnerAttributes"
         id="@ElementId"
         class="@CssClass"
         style="@CssStyle"
         data-testid="@TestId">
        <dt class="veto-shortcut__description">
            @if (ChildContent is not null)
            {
                @ChildContent
            }
            else
            {
                @Description
            }
        </dt>
        <dd class="veto-shortcut__keys">
            @if (KeysContent is not null)
            {
                @KeysContent
            }
            else
            {
                <VetoKbd Keys="@Keys" Size="@Size" Separator="@Separator" ShowSeparator="@ShowSeparator" Symbols="@Symbols" Mac="@Mac" Bordered="@Bordered" TestId="@(TestId is null ? null : $"{TestId}-kbd")" />
            }
        </dd>
    </div>
}
