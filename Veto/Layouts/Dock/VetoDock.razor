@namespace Veto.Layouts.Dock
@inherits Veto.Core.VetoComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (Visible)
{
    <CascadingValue Value="this" IsFixed="true">
        <div class="@CssClass" style="@CssStyle" data-testid="@TestId">
            @if (AutoHide)
            {
                <div class="veto-dock__reveal" aria-hidden="true"></div>
            }

            <div @ref="RootElement"
                 @attributes="InnerAttributes"
                 id="@ElementId"
                 class="veto-dock__bar"
                 role="toolbar"
                 aria-label="@Label"
                 aria-orientation="@(Position.IsVertical() ? "vertical" : "horizontal")"
                 @onkeydown="OnKeyDownAsync">
                @ChildContent
            </div>
        </div>
    </CascadingValue>
}
