<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright.Xunit" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Referenced so the demo app is always rebuilt before the tests run; the fixture then
    launches it as a real server rather than hosting it in-process (Blazor WebAssembly
    needs the published static assets).
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\VetoWeb\VetoWeb\VetoWeb.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    Referenced for its assembly, unlike the demo app above: a few components carry pure logic
    worth testing directly - the cron parser, describer and scheduler - where driving the
    browser would be slower and would find less.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\Veto\Veto.csproj" />
  </ItemGroup>

</Project>
