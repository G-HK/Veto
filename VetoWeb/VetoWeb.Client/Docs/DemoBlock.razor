@* One worked example: what it does, the live component, and the markup that produced it. *@
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IVetoToastService Toasts

<VetoStack Gap="VetoSpacing.Medium" TestId="@TestId" Id="@Anchor" Class="demo-block">
    <VetoStack Gap="VetoSpacing.ExtraSmall">
        <h3 class="demo-block__title">
            <a class="demo-block__anchor" href="@AnchorHref" @onclick="CopyLinkAsync" aria-label="@($"Link to {Title}")">#</a>
            @Title
        </h3>
        @if (Description is not null)
        {
            <p class="demo-block__description">@Description</p>
        }
    </VetoStack>

    <VetoCard Elevation="VetoElevation.Outlined" Padding="VetoSpacing.ExtraLarge" Class="demo-block__stage"
              RootOverflow="@(ClipStage ? null : VetoOverflow.Visible)">
        @ChildContent
    </VetoCard>

    @if (Code is not null)
    {
        <VetoCode Code="@Code" Language="razor" TestId="@(TestId is null ? null : $"{TestId}-code")" />
    }
</VetoStack>

@code {
    [CascadingParameter]
    private DocsPage? Page { get; set; }

    // "With icons" -> "WithIcons": the section's id, so /docs/components/button#WithIcons lands here.
    private string Anchor => string.Concat(Title.Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Select(w => char.ToUpperInvariant(w[0]) + w[1..]).SelectMany(w => w.Where(char.IsLetterOrDigit)));

    // Path plus fragment, not a bare "#id": a bare fragment resolves against <base href="/">.
    private string AnchorHref => $"/{Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0]}#{Anchor}";

    protected override void OnInitialized () => Page?.Register(Anchor, Title);

    // The link still navigates (no preventDefault); this also puts the full URL on the clipboard.
    private async Task CopyLinkAsync ()
    {
        var url = Nav.ToAbsoluteUri(AnchorHref).ToString();
        await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Veto.Code/veto-code.js");

        if (await module.InvokeAsync<bool>("copyText", url))
        {
            Toasts.Success("Link copied to clipboard");
        }
        else
        {
            Toasts.Error("Could not copy the link");
        }
    }

    /// <summary>What this example demonstrates.</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>Why it matters, or what to notice.</summary>
    [Parameter]
    public string? Description { get; set; }

    /// <summary>The live example.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>The markup that produced the example.</summary>
    [Parameter]
    public string? Code { get; set; }

    /// <summary>Test hook for the block.</summary>
    [Parameter]
    public string? TestId { get; set; }

    /// <summary>
    /// Whether the stage clips what is on it. Turn it off for a demo whose component opens a
    /// panel beyond its own bounds - a menu, or anything else positioned against a trigger -
    /// which the stage would otherwise cut off at its edge.
    /// </summary>
    [Parameter]
    public bool ClipStage { get; set; } = true;
}