        @code {
            // A field, not AsyncItems="StreamCars()": an inline call is a new stream on every
            // render, and a new stream is how the table knows to start over.
            private IAsyncEnumerable<Car> _cars = StreamCars(c => c.DealerID == 1);

            // The table reads only as far as the page it shows (and one row further, so Next
            // knows whether there is another page). Swap the loop for your API's paged calls.
            private static async IAsyncEnumerable<Car> StreamCars (
                Func<Car, bool>? filter = null,
                [EnumeratorCancellation] CancellationToken cancellationToken = default )
            {
                var index = 0;

                foreach (var car in Data.Get().Cars.Where(filter ?? (_ => true)))
                {
                    // A pretend network: every ten rows take a moment to arrive.
                    if (index++ % 10 == 0)
                    {
                        await Task.Delay(350, cancellationToken);
                    }

                    yield return car;
                }
            }
        }
        """;

