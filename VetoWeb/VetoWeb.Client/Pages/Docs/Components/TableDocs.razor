        new("PageSizeChanged", "EventCallback<int>", "—", "Raised when the picker changes the page size. Bind PageSize to follow it."),
        new("Sort", "VetoTableSort?", "null", "The sorted column's key and direction. Bindable; with AsyncItems or ItemsProvider, the source sorts by it."),
        new("SortChanged", "EventCallback<VetoTableSort?>", "—", "Raised when a sortable header is clicked."),
        new("RangeText", "Func<int, int, int?, string>?", "null", "The pager's range line from the first and last row and the total."),
        new("FirstText", "string", "\"First page\"", "The First button's accessible name."),
        new("PreviousText", "string", "\"Previous page\"", "The Previous button's accessible name."),
        new("NextText", "string", "\"Next page\"", "The Next button's accessible name."),
        new("LastText", "string", "\"Last page\"", "The Last button's accessible name."),
        new("PageText", "string", "\"Page\"", "The word in the page buttons' names: \"Page 4\"."),
        new("RowsPerPageText", "string", "\"Rows per page\"", "The page-size picker's label."),
        new("GoToPageText", "string", "\"Go to page\"", "The go-to-page box's label."),
        new("TableSortHeader Title", "string", "—", "A sortable header cell, in HeaderTemplate: its text, and its key by default."),
        new("TableSortHeader By", "Func<TItem, object?>?", "null", "The value the table sorts Items by."),
        new("TableSortHeader SortKey", "string?", "Title", "The key reported in Sort."),
        new("LoadMoreText", "string", "\"Load more\"", "The Load more button's text, when scrolling."),
        new("LoadingText", "string", "\"Loading…\"", "Shown while rows are read from AsyncItems."),
        new("ErrorText", "string", "\"The rows could not be loaded.\"", "Shown if AsyncItems throws."),
        new("RowHeight", "float", "37", "A row's height in pixels when virtualized; sizes the space for the rows not rendered."),
        new("OverscanCount", "int", "5", "Rows rendered beyond the visible ones when virtualized.")
    ];

    // Each sample is the whole component behind its demo, ready to paste into a .razor file.
