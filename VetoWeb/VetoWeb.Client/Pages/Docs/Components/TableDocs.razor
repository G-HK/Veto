                <td>@context.FuelType</td>
                <td>@context.HorsePower hp</td>
                <td>@context.Price.ToString("N0")</td>
                <td>@context.Dealer.Name</td>
            </RowTemplate>
        </Table>

        @code {
            private IAsyncEnumerable<Car> _feed = StreamCars();
            private bool _electricOnly;

            // A new stream starts the table over from the top; the old one is cancelled.
            private void Filter ( bool electricOnly )
            {
                if (electricOnly == _electricOnly)
                {
                    return;
                }

                _electricOnly = electricOnly;
                _feed = StreamCars(electricOnly ? c => c.FuelType == FuelType.Electric : null);
            }

            private static async IAsyncEnumerable<Car> StreamCars (
                Func<Car, bool>? filter = null,
                [EnumeratorCancellation] CancellationToken cancellationToken = default )
            {
                var index = 0;

                foreach (var car in Data.Get().Cars.Where(filter ?? (_ => true)))
                {
                    // A pretend network: every ten rows take a moment to arrive.
                    if (index++ % 10 == 0)
                    {
                        await Task.Delay(350, cancellationToken);
                    }

                    yield return car;
                }
            }
        }
        """;

    private const string VirtualCode = """
        @using Microsoft.AspNetCore.Components.Web.Virtualization
        @using Veto.Components.Table
        @using VetoWeb.Client.DemoData
        @using VetoWeb.Client.DemoData.Models

        <Table TItem="Car" ItemsProvider="LoadCarsAsync" @bind-Sort="_sort" ItemKey="c => c.ID"
               StickyHeader="true" RootMaxHeight="20rem">
            <HeaderTemplate>
                @* No By: the table cannot reorder rows it does not hold, so the provider sorts. *@
                <TableSortHeader Title="#" SortKey="ID" />
                <TableSortHeader Title="Car" />
                <TableSortHeader Title="Fuel" />
                <TableSortHeader Title="Power" />
                <TableSortHeader Title="Price" />
                <TableSortHeader Title="Dealer" />
            </HeaderTemplate>
            <RowTemplate>
                <td>@context.ID</td>
                <td>@context.Name</td>
                <td>@context.FuelType</td>
                <td>@context.HorsePower hp</td>
                <td>@context.Price.ToString("N0")</td>
                <td>@context.Dealer.Name</td>
            </RowTemplate>
        </Table>

        @code {
            private VetoTableSort? _sort;
            private (VetoTableSort? By, IReadOnlyList<Car> Cars)? _ordered;

            // Called for each range Virtualize needs: the rows in view, in the bound sort's order,
            // and how many there are in all. Against an API: pass the sort, start and count on.
            private async ValueTask<ItemsProviderResult<Car>> LoadCarsAsync ( ItemsProviderRequest request )
            {
                await Task.Delay(120, request.CancellationToken);   // a pretend network

                var cars = OrderedCars(_sort);
                return new ItemsProviderResult<Car>(cars.Skip(request.StartIndex).Take(request.Count), cars.Count);
            }

            // The server's ORDER BY: sorted once per sort, not once per range.
            private IReadOnlyList<Car> OrderedCars ( VetoTableSort? sort )
            {
                if (_ordered is { } cached && cached.By == sort)
                {
                    return cached.Cars;
                }

                var all = Data.Get().Cars;
                Func<Car, object> key = sort?.Key switch
                {
                    "Car" => c => c.Name,
                    "Fuel" => c => c.FuelType.ToString(),
                    "Power" => c => c.HorsePower,
                    "Price" => c => c.Price,
                    "Dealer" => c => c.Dealer.Name,
                    _ => c => c.ID
                };

                IReadOnlyList<Car> ordered = sort?.Direction == VetoSortDirection.Descending
                    ? [.. all.OrderByDescending(key)]
                    : [.. all.OrderBy(key)];

                _ordered = (sort, ordered);
                return ordered;
            }
        }

        @* After the data behind the provider changes - a new filter, say - ask again:
           <Table @ref="_table" ...>  then  await _table.RefreshAsync(); *@
        """;
}