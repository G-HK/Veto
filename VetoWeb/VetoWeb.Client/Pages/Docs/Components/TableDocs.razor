    private const string StreamPagesCode = """
        @using System.Runtime.CompilerServices
        @using Veto.Components.Table
        @using VetoWeb.Client.DemoData
        @using VetoWeb.Client.DemoData.Models

        <Table TItem="Car" AsyncItems="_cars" ItemKey="c => c.ID"
               Paging="VetoTablePaging.Pages" PageSize="5" PageSizeOptions="[5, 15, 30]">
            <HeaderTemplate>
                <th>Car</th>
                <th>Fuel</th>
