        new("AsyncItems", "IAsyncEnumerable<TItem>?", "null", "The items as a stream, read only as far as the page or scroll needs. Instead of Items; a new stream starts over."),
        new("ItemsProvider", "ItemsProviderDelegate<TItem>?", "null", "Fetches the rows in view a range at a time - Virtualize's contract. Instead of Items or AsyncItems; always virtualizes."),
        new("Paging", "VetoTablePaging", "None", "None, Pages (Previous and Next), Scroll (the next batch as the end comes into view) or Virtualize (only the rows in view are rendered)."),
        new("PageSize", "int", "25", "Rows per page, or per batch when scrolling."),
        new("PageIndex", "int", "0", "The page shown, from 0. Bindable."),
