@page "/docs/components/table"
@rendermode InteractiveWebAssembly
@using System.Runtime.CompilerServices
@using Veto.Components.Table
@using VetoWeb.Client.DemoData
@using VetoWeb.Client.DemoData.Models

<PageTitle>Table — Veto</PageTitle>

<DocsPage Eyebrow="Components"
          Title="Table"
          Lead="A templated table: you write the header cells and one row template, the table draws every row, the empty state, stripes and hover.">

    <DemoBlock TestId="demo-basic"
               Title="Basic"
               Description="HeaderTemplate holds the header cells, RowTemplate one row's cells with the item as context, and FooterTemplate an optional totals row."
               Code="@BasicCode">
        <Table TItem="Order" TestId="basic" Items="_orders" Caption="Recent orders">
            <HeaderTemplate>
                <th>Order</th>
                <th>Customer</th>
                <th>Total</th>
            </HeaderTemplate>
            <RowTemplate>
                <td>@context.Number</td>
                <td>@context.Customer</td>
                <td>@context.Total.ToString("0.00")</td>
            </RowTemplate>
            <FooterTemplate>
                <td colspan="2">Total</td>
                <td data-testid="basic-total">@(_orders.Sum(o => o.Total).ToString("0.00"))</td>
            </FooterTemplate>
        </Table>
    </DemoBlock>

    <DemoBlock TestId="demo-empty"
               Title="Empty state"
               Description="With no items - or a null list - the body says so instead of collapsing to nothing. EmptyText for a sentence, EmptyContent for markup."
               Code="@EmptyCode">
        <VetoStack Gap="VetoSpacing.Medium">
            <Table TItem="Order" TestId="empty" Items="null">
                <HeaderTemplate><th>Order</th><th>Customer</th></HeaderTemplate>
                <RowTemplate><td>@context.Number</td><td>@context.Customer</td></RowTemplate>
            </Table>
            <Table TItem="Order" TestId="empty-custom" Items="Array.Empty<Order>()">
                <HeaderTemplate><th>Order</th><th>Customer</th></HeaderTemplate>
                <RowTemplate><td>@context.Number</td><td>@context.Customer</td></RowTemplate>
                <EmptyContent><strong>No orders yet.</strong> They show up here as they come in.</EmptyContent>
            </Table>
        </VetoStack>
    </DemoBlock>

    <DemoBlock TestId="demo-options"
               Title="Look"
               Description="Striped, Bordered and Hover are on by default and can each be turned off. Dense tightens the cells."
               Code="@OptionsCode">
        <Table TItem="Order" TestId="plain" Items="_orders" Striped="false" Bordered="false" Hover="false" Dense="true">
            <HeaderTemplate><th>Order</th><th>Customer</th><th>Total</th></HeaderTemplate>
            <RowTemplate><td>@context.Number</td><td>@context.Customer</td><td>@context.Total.ToString("0.00")</td></RowTemplate>
        </Table>
    </DemoBlock>

    <DemoBlock TestId="demo-interactive"
               Title="Clickable rows, row classes and a sticky header"
               Description="OnRowClick makes every row focusable and raises the item on click, Enter or Space. RowClass adds classes worked out from the item. StickyHeader keeps the header in view while the rows scroll inside RootMaxHeight."
               Code="@InteractiveCode">
        <VetoStack Gap="VetoSpacing.Small">
            <Table TItem="Order" TestId="clickable" Items="_manyOrders" StickyHeader="true" RootMaxHeight="12rem"
                   OnRowClick="o => _picked = o.Number" RowClass='o => o.Total > 100 ? "demo-large-order" : null'>
                <HeaderTemplate><th>Order</th><th>Customer</th><th>Total</th></HeaderTemplate>
                <RowTemplate><td>@context.Number</td><td>@context.Customer</td><td>@context.Total.ToString("0.00")</td></RowTemplate>
            </Table>
            <span class="demo-value" data-testid="clickable-value">@(_picked ?? "none")</span>
        </VetoStack>
    </DemoBlock>

    <DemoBlock TestId="demo-pages" Title="Pages"
               Description="Paging=&quot;Pages&quot; over all 1,000 demo cars. The pager has first, previous, the page numbers, next and last, a box to go straight to a page, and a rows-per-page picker - 5, 10, 25, 50 or 100 unless you set PageSizeOptions. Click a column header to sort: with Items the table sorts by the header's By itself. Bind PageIndex to follow or set the page from outside."
               Code="@PagesCode">
        <VetoStack Gap="VetoSpacing.Small">
            <Table TItem="Car" TestId="paged" Items="Data.Get().Cars" Paging="VetoTablePaging.Pages" PageSize="10"
                   @bind-PageIndex="_page" StickyHeader="true" RootMaxHeight="16rem" ItemKey="c => c.ID">
                <HeaderTemplate>
                    <TableSortHeader Title="Car" By="c => c.Name" TestId="paged-sort-car" />
                    <TableSortHeader Title="Fuel" By="c => c.FuelType.ToString()" />
                    <TableSortHeader Title="Power" By="c => c.HorsePower" TestId="paged-sort-power" />
                    <TableSortHeader Title="Price" By="c => c.Price" TestId="paged-sort-price" />
                    <TableSortHeader Title="Dealer" By="c => c.Dealer.Name" />
                </HeaderTemplate>
                <RowTemplate>@CarCells(context)</RowTemplate>
            </Table>
            <VetoStack Orientation="VetoOrientation.Horizontal" Gap="VetoSpacing.Small" Align="VetoAlign.Center">
                <VetoButton Variant="VetoVariant.Outlined" Size="VetoSize.Small" TestId="paged-set-first" OnClick="() => _page = 0">Set PageIndex to 0</VetoButton>
                <VetoButton Variant="VetoVariant.Outlined" Size="VetoSize.Small" TestId="paged-set-last"
                            OnClick="() => _page = 99">Set PageIndex to 99</VetoButton>
                <span class="demo-value">PageIndex: <strong data-testid="paged-index">@_page</strong></span>
            </VetoStack>
        </VetoStack>
    </DemoBlock>

    <DemoBlock TestId="demo-stream-pages" Title="Pages from a stream"
               Description="Give AsyncItems an IAsyncEnumerable instead and each page is read only when it is asked for - one row further, so Next knows whether there is another page. The page count, and the Last button, arrive once the stream runs out. Here: one dealer's stock, with the developer's own page sizes - PageSizeOptions=&quot;[5, 15, 30]&quot;."
               Code="@StreamPagesCode">
        <Table TItem="Car" TestId="stream-paged" AsyncItems="_pagedStream" Paging="VetoTablePaging.Pages" PageSize="5"
               PageSizeOptions="[5, 15, 30]" ItemKey="c => c.ID">
            <HeaderTemplate><th>Car</th><th>Fuel</th><th>Power</th><th>Price</th><th>Dealer</th></HeaderTemplate>
            <RowTemplate>@CarCells(context)</RowTemplate>
        </Table>
    </DemoBlock>

    <DemoBlock TestId="demo-scroll" Title="Infinite scroll"
               Description="Paging=&quot;Scroll&quot; reads the next PageSize rows as the end of the table comes into view - here inside RootMaxHeight, with a sticky header. Load more does the same from the keyboard. Passing a new stream starts over: try a filter."
               Code="@ScrollCode">
        <VetoStack Gap="VetoSpacing.Small">
            <VetoStack Orientation="VetoOrientation.Horizontal" Gap="VetoSpacing.Small">
                <VetoButton Variant="@(_electricOnly ? VetoVariant.Outlined : VetoVariant.Filled)" Size="VetoSize.Small"
                            aria-pressed="@(_electricOnly ? "false" : "true")" TestId="feed-all"
                            OnClick="() => Filter(false)">All cars</VetoButton>
                <VetoButton Variant="@(_electricOnly ? VetoVariant.Filled : VetoVariant.Outlined)" Size="VetoSize.Small"
                            aria-pressed="@(_electricOnly ? "true" : "false")" TestId="feed-electric"
                            OnClick="() => Filter(true)">Electric only</VetoButton>
            </VetoStack>
            <Table TItem="Car" TestId="feed" AsyncItems="_feed" Paging="VetoTablePaging.Scroll" PageSize="10"
                   StickyHeader="true" RootMaxHeight="18rem" ItemKey="c => c.ID">
                <HeaderTemplate><th>Car</th><th>Fuel</th><th>Power</th><th>Price</th><th>Dealer</th></HeaderTemplate>
                <RowTemplate>@CarCells(context)</RowTemplate>
            </Table>
        </VetoStack>
    </DemoBlock>

    <DemoBlock TestId="demo-virtual" Title="Virtualized: a thousand rows"
               Description="ItemsProvider fetches rows a range at a time - a start and a count in, those rows and the total out. Only the rows in view are in the page; Virtualize sizes the space for the rest from RowHeight, and asks for each range as it scrolls into view. The table cannot reorder rows it does not hold, so sorting here is the provider's job: it reads the bound Sort, and the table asks again when a header is clicked."
               Code="@VirtualCode">
        <Table TItem="Car" TestId="virtual" ItemsProvider="LoadCarsAsync" @bind-Sort="_virtualSort"
               StickyHeader="true" RootMaxHeight="20rem" ItemKey="c => c.ID">
            <HeaderTemplate>
                <TableSortHeader Title="#" SortKey="ID" />
                <TableSortHeader Title="Car" />
                <TableSortHeader Title="Fuel" />
                <TableSortHeader Title="Power" TestId="virtual-sort-power" />
                <TableSortHeader Title="Price" />
                <TableSortHeader Title="Dealer" />
            </HeaderTemplate>
            <RowTemplate><td>@context.ID</td>@CarCells(context)</RowTemplate>
        </Table>
    </DemoBlock>

    <ParameterTable TestId="parameters" Rows="Parameters" />

</DocsPage>

@code {
    private sealed record Order ( string Number, string Customer, decimal Total );

    private readonly Order[] _orders =
    [
        new("#1001", "Ada Lovelace", 42.50m),
        new("#1002", "Alan Turing", 120.00m),
        new("#1003", "Grace Hopper", 18.75m)
    ];

    private readonly Order[] _manyOrders =
        [.. Enumerable.Range(1, 20).Select(i => new Order($"#{2000 + i}", $"Customer {i}", i * 11.5m))];

    private string? _picked;

    // Fields, not inline calls: a new stream is how the table knows to start over.
    private IAsyncEnumerable<Car> _pagedStream = StreamCars(c => c.DealerID == 1);
    private int _page;
    private VetoTableSort? _virtualSort;
    private (VetoTableSort? By, IReadOnlyList<Car> Cars)? _virtualOrder;
    private IAsyncEnumerable<Car> _feed = StreamCars();
    private bool _electricOnly;

    private void Filter ( bool electricOnly )
    {
        if (electricOnly == _electricOnly)
        {
            return;
        }

        _electricOnly = electricOnly;
        _feed = StreamCars(electricOnly ? c => c.FuelType == FuelType.Electric : null);
    }

    /// <summary>
    /// The demo cars as a stream, with a pretend network: every ten rows take a moment to arrive.
    /// Only in the browser - the server's prerender should not wait on a pretend delay.
    /// </summary>
    private static async IAsyncEnumerable<Car> StreamCars (
        Func<Car, bool>? filter = null, [EnumeratorCancellation] CancellationToken cancellationToken = default )
    {
        var index = 0;

        foreach (var car in Data.Get().Cars.Where(filter ?? (_ => true)))
        {
            if (index++ % 10 == 0 && OperatingSystem.IsBrowser())
            {
                await Task.Delay(350, cancellationToken);
            }

            yield return car;
        }
    }

    /// <summary>
    /// What an API endpoint would do for the virtualized demo: one range of the cars, in the order
    /// the bound Sort asks for, and how many there are in all. The pretend latency is
    /// browser-only, like the stream's.
    /// </summary>
    private async ValueTask<ItemsProviderResult<Car>> LoadCarsAsync ( ItemsProviderRequest request )
    {
        if (OperatingSystem.IsBrowser())
        {
            await Task.Delay(120, request.CancellationToken);
        }

        var cars = OrderedCars(_virtualSort);
        return new ItemsProviderResult<Car>(cars.Skip(request.StartIndex).Take(request.Count), cars.Count);
    }

    /// <summary>The server's ORDER BY: sorted once per sort, not once per range.</summary>
    private IReadOnlyList<Car> OrderedCars ( VetoTableSort? sort )
    {
        if (_virtualOrder is { } cached && cached.By == sort)
        {
            return cached.Cars;
        }

        var all = Data.Get().Cars;
        Func<Car, object> key = sort?.Key switch
        {
            "Car" => c => c.Name,
            "Fuel" => c => c.FuelType.ToString(),
            "Power" => c => c.HorsePower,
            "Price" => c => c.Price,
            "Dealer" => c => c.Dealer.Name,
            _ => c => c.ID
        };

        IReadOnlyList<Car> ordered = sort?.Direction == VetoSortDirection.Descending
            ? [.. all.OrderByDescending(key)]
            : [.. all.OrderBy(key)];

        _virtualOrder = (sort, ordered);
        return ordered;
    }

    private static RenderFragment CarCells ( Car car ) =>
        @<text>
            <td>@car.Name</td>
            <td>@car.FuelType</td>
            <td>@car.HorsePower hp</td>
            <td>@car.Price.ToString("N0")</td>
            <td>@car.Dealer.Name</td>
        </text>;

