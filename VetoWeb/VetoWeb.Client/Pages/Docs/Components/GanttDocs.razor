@page "/docs/components/gantt"
@rendermode InteractiveWebAssembly
@using Veto.Components.Gantt

<PageTitle>Gantt — Veto</PageTitle>

<DocsPage Eyebrow="Components"
          Title="Gantt"
          Lead="Projects and tasks on the left, a scrollable timeline on the right. Filtering, zoom, date navigation and export are built in.">

    <DemoBlock TestId="demo-today" Title="Today's work"
               Description="The chart opens on today: the axis covers today alone, stretched across the full width, and only the rows with work today are listed - not yesterday's, not tomorrow's. The Today / Schedule switch in the toolbar opens the whole plan, and View can be bound or set to start there."
               Code="@TodayCode">
        <VetoGantt TestId="today-view"
                   Items="Tasks"
                   TodayOverride="Today"
                   SidebarWidth="13rem"
                   Height="14rem"
                   @bind-View="_todayView" />
    </DemoBlock>

    <DemoBlock TestId="demo-hours" Title="Jobs by the hour"
               Description="Give an item a StartTime and EndTime and it is placed to the minute. The today view draws hours, marks now, and lists only what runs today - last night's backup and tomorrow's release are not on it. Inline, a whole day of jobs sits on one line. StartTime and EndTime on the chart itself trim the day to a window: 14:00 to 20:00 below, stretched across the full width."
               Code="@HoursCode">
        <VetoStack Gap="VetoSpacing.Large">
            <VetoGantt TestId="hours"
                       Items="Jobs"
                       TodayOverride="Today"
                       TimeOverride="new TimeOnly(11, 30)"
                       SubItemLayout="VetoGanttSubItemLayout.Inline"
                       SidebarWidth="13rem"
                       Height="11rem" />

            <VetoGantt TestId="window"
                       Items="Jobs"
                       TodayOverride="Today"
                       TimeOverride="new TimeOnly(11, 30)"
                       StartTime="new TimeOnly(14, 0)"
                       EndTime="new TimeOnly(20, 0)"
                       ShowToolbar="false"
                       SidebarWidth="13rem"
                       Height="11rem" />
        </VetoStack>
    </DemoBlock>

    <DemoBlock TestId="demo-fit" Title="A short range fills the width"
               Description="Give the chart a Start and End a few days apart and the days widen until the range spans the whole chart, rather than drawing a week at the scale's own density and leaving the rest empty. A range longer than the chart keeps its density and scrolls. FitToWidth=false turns this off."
               Code="@FitCode">
        <VetoGantt TestId="fit"
                   Items="Tasks"
                   View="VetoGanttView.Schedule"
                   TodayOverride="Today"
                   Start="new DateOnly(2026, 3, 14)"
                   End="new DateOnly(2026, 3, 20)"
                   ShowToolbar="false"
                   SidebarWidth="13rem"
                   Height="17rem" />
    </DemoBlock>

    <DemoBlock TestId="demo-inline" Title="Many jobs on one line"
               Description="SubItemLayout=Inline draws a parent's jobs side by side on the parent's own line, rather than a row each - a pipeline with a run a day stays one row. The fold arrow still opens it into rows when you want the detail; Collapsible=false takes the arrow away and keeps every parent on one line."
               Code="@InlineCode">
        <VetoStack Gap="VetoSpacing.Large">
            <VetoGantt TestId="inline"
                       Items="Pipelines"
                       View="VetoGanttView.Schedule"
                       TodayOverride="Today"
                       SubItemLayout="VetoGanttSubItemLayout.Inline"
                       ShowToolbar="false"
                       SidebarWidth="13rem"
                       Height="9rem"
                       ScrollToTodayOnLoad="false" />

            <VetoGantt TestId="inline-fixed"
                       Items="Pipelines"
                       View="VetoGanttView.Schedule"
                       TodayOverride="Today"
                       SubItemLayout="VetoGanttSubItemLayout.Inline"
                       Collapsible="false"
                       ShowToolbar="false"
                       SidebarWidth="13rem"
                       Height="9rem"
                       ScrollToTodayOnLoad="false" />
        </VetoStack>
    </DemoBlock>

    <DemoBlock TestId="demo-basic" Title="A schedule"
               Description="Projects collapse, tasks indent beneath them, and a summary bar spans its children as a slim rail rather than a block. Each category carries its own colour, and the filter chips are tinted to match - so the filter is also the key to the bars. Switch the scale, or use Today to jump back to now."
               Code="@BasicCode">
        <VetoGantt TestId="chart" View="VetoGanttView.Schedule" Items="Tasks" TodayOverride="Today" @bind-Scale="_scale"
                   @bind-SelectedId="_selectedId" Height="26rem" OnExport="OnExport" />
    </DemoBlock>

    <DemoBlock TestId="demo-filters" Title="Filters you control"
               Description="Filters takes toggles of your own - any predicate over an item - and they sit in the toolbar beside the categories. The category filter and your toggles bind both ways, so the page can set them and hears every click; OnFilterChanged reports the whole picture, rows included, after any change. ItemFilter applies a rule with no toggle at all."
               Code="@FiltersCode">
        <VetoStack Gap="VetoSpacing.Medium">
            <VetoStack Orientation="VetoOrientation.Horizontal" Gap="VetoSpacing.Small" Wrap="true">
                <button class="chip" type="button" data-testid="filters-hide-marketing" @onclick='() => _hidden = ["Marketing"]'>Hide Marketing</button>
                <button class="chip" type="button" data-testid="filters-underway" @onclick='() => _active = ["underway"]'>Only work under way</button>
                <button class="chip" type="button" data-testid="filters-clear" @onclick="() => _filtered.ClearFiltersAsync()">Clear filters</button>
            </VetoStack>

            <VetoGantt @ref="_filtered"
                       TestId="filters"
                       Items="Tasks"
                       View="VetoGanttView.Schedule"
                       TodayOverride="Today"
                       Filters="TaskFilters"
                       @bind-HiddenCategories="_hidden"
                       @bind-ActiveFilters="_active"
                       OnFilterChanged="OnFilterChanged"
                       Exportable="false"
                       SidebarWidth="13rem"
                       Height="17rem"
                       ScrollToTodayOnLoad="false" />

            <span class="demo-label" data-testid="filters-state">@_filterState</span>
        </VetoStack>
    </DemoBlock>

    <DemoBlock TestId="demo-limits" Title="Only the controls you want"
               Description="Scales lists the zoom levels the picker offers - give it one, Day here, and there is nothing to pick, so the picker goes. ExportFormats lists the formats the export menu offers; CSV alone here, and an empty list hides the menu."
               Code="@LimitsCode">
        <VetoGantt TestId="limited"
                   Items="Tasks"
                   View="VetoGanttView.Schedule"
                   TodayOverride="Today"
                   Scales="DayOnly"
                   ExportFormats="CsvOnly"
                   ShowSearch="false"
                   ShowCategoryFilter="false"
                   SidebarWidth="13rem"
                   Height="12rem" />
    </DemoBlock>

    <DemoBlock TestId="demo-selection"
               Title="Selection"
               Description="Bars are buttons, so they are reachable by keyboard and announce themselves. OnItemSelected gives you the row that was activated; SelectedId can be bound both ways."
               Code="@SelectionCode">
        <VetoStack Gap="VetoSpacing.Small">
            <span class="demo-value" data-testid="selection">@(_selectedId is null ? "Nothing selected — click a bar above." : $"Selected: {_selectedId}")</span>
            <span class="demo-value" data-testid="export-note">@_exportNote</span>
        </VetoStack>
    </DemoBlock>

    <DemoBlock TestId="demo-milestones"
               Title="Milestones and colours"
               Description="A milestone is a point rather than a span, drawn as the conventional diamond. Any row can carry its own colour - including a theme token, so it follows light and dark."
               Code="@ColorCode">
        <VetoGantt TestId="colors" View="VetoGanttView.Schedule"
                   Items="Milestones"
                   TodayOverride="Today"
                   Scale="VetoGanttScale.Week"
                   ShowToolbar="false"
                   SidebarWidth="12rem"
                   Height="14rem"
                   ScrollToTodayOnLoad="false" />
    </DemoBlock>

    <DemoBlock TestId="demo-chain"
               Title="Chained tasks"
               Description="A row that cannot start until another finishes lists it in DependsOn, and the chain is drawn as an arrow from the end of one bar to the start of the next. Select a row and the arrows touching it are picked out, which is how you follow a chain through a crowded schedule. The last arrow here routes back on itself, because that dependency is already broken - the successor starts before its predecessor ends."
               Code="@ChainCode">
        <VetoGantt TestId="chain" View="VetoGanttView.Schedule"
                   Items="Chain"
                   TodayOverride="Today"
                   ShowToolbar="false"
                   SidebarWidth="12rem"
                   Height="15rem"
                   ScrollToTodayOnLoad="false"
                   @bind-SelectedId="_chainSelection" />
    </DemoBlock>

    <DemoBlock TestId="demo-tooltips"
               Title="Tooltips"
               Description="Hovering or focusing a bar shows its name, dates, progress and description. TooltipText rewrites that text, and returning null leaves a row without one. TooltipTemplate swaps the browser's tooltip for a card you lay out yourself. ShowTooltips=false turns them off, and the bars keep their accessible names."
               Code="@TooltipCode">
        <VetoStack Gap="VetoSpacing.Large">
            <VetoGantt TestId="tooltip-text" View="VetoGanttView.Schedule"
                       Items="Tasks"
                       TodayOverride="Today"
                       ShowToolbar="false"
                       SidebarWidth="12rem"
                       Height="14rem"
                       ScrollToTodayOnLoad="false"
                       TooltipText="ShortTooltip" />

            <VetoGantt TestId="tooltip-card" View="VetoGanttView.Schedule"
                       Items="Tasks"
                       TodayOverride="Today"
                       ShowToolbar="false"
                       SidebarWidth="12rem"
                       Height="14rem"
                       ScrollToTodayOnLoad="false">
                <TooltipTemplate Context="task">
                    <strong>@task.Name</strong>
                    <div>@task.Start.ToString("d MMM") – @task.End.ToString("d MMM") · @task.DurationDays days</div>
                    @if (task.Progress is { } done)
                    {
                        <div>@done.ToString("P0") done</div>
                    }
                    @if (task.Category is not null)
                    {
                        <div>@task.Category</div>
                    }
                </TooltipTemplate>
            </VetoGantt>
        </VetoStack>
    </DemoBlock>

    <DemoBlock TestId="demo-ref"
               Title="Driving it from code"
               Description="Take an @@ref and the chart's own actions are yours to call: select a row, fold the tree, zoom, scroll to a date, export, or open a row's tooltip card to point something out. Each one does what its button or bar would, callbacks included, so bound state stays in step."
               Code="@RefCode">
        <VetoStack Gap="VetoSpacing.Medium">
            <VetoStack Orientation="VetoOrientation.Horizontal" Gap="VetoSpacing.Small" Wrap="true">
                <button class="chip" type="button" data-testid="ref-select" @onclick='() => _driven.SelectAsync("shell")'>Select App shell</button>
                <button class="chip" type="button" data-testid="ref-collapse-all" @onclick="() => _driven.CollapseAll()">Collapse all</button>
                <button class="chip" type="button" data-testid="ref-expand-all" @onclick="() => _driven.ExpandAll()">Expand all</button>
                <button class="chip" type="button" data-testid="ref-week" @onclick="() => _driven.SetScaleAsync(VetoGanttScale.Week)">Week view</button>
                <button class="chip" type="button" data-testid="ref-launch" @onclick="() => _driven.ScrollToDateAsync(new(2026, 4, 13))">Go to launch</button>
                <button class="chip" type="button" data-testid="ref-tooltip" @onclick='() => _driven.ShowTooltip("design")'>Point out Design</button>
                <button class="chip" type="button" data-testid="ref-hide" @onclick="() => _driven.HideTooltip()">Hide card</button>
            </VetoStack>

            <VetoGantt @ref="_driven"
                       TestId="driven" View="VetoGanttView.Schedule"
                       Items="Tasks"
                       TodayOverride="Today"
                       ShowToolbar="false"
                       SidebarWidth="12rem"
                       Height="16rem"
                       ScrollToTodayOnLoad="false"
                       @bind-SelectedId="_drivenSelection"
                       @bind-Scale="_drivenScale">
                <TooltipTemplate Context="task">
                    <strong>@task.Name</strong>
                    <div>@task.DurationDays days</div>
                </TooltipTemplate>
            </VetoGantt>

            <span class="demo-label" data-testid="driven-state">Selected: @(_drivenSelection ?? "none") · Scale: @_drivenScale</span>
        </VetoStack>
    </DemoBlock>

    <DemoBlock TestId="demo-edit"
               Title="Dragging, and remembering"
               Description="Drag a bar to move it, or its edges to resize - snapped to whatever zoom is showing. Arrow keys do the same from the keyboard, with Shift to change the end instead. Changes are kept in this browser for you alone, so a reload finds them again; Reset clears them. A summary row cannot be dragged, because its dates are the span of its children."
               Code="@EditCode">
        <VetoStack Gap="VetoSpacing.Medium">
            <VetoGantt TestId="editable" View="VetoGanttView.Schedule"
                       Items="Editable"
                       TodayOverride="Today"
                       Editable="true"
                       PersistKey="veto-docs-gantt"
                       SortBy="_sort"
                       Height="17rem"
                       SidebarWidth="13rem"
                       ScrollToTodayOnLoad="false"
                       ShowScalePicker="true"
                       ShowCategoryFilter="false"
                       ShowSearch="false"
                       OnItemChanged="OnChanged" />

            <VetoStack Orientation="VetoOrientation.Horizontal" Gap="VetoSpacing.Medium" Align="VetoAlign.Center" Wrap="true">
                <span class="demo-label">Order</span>
                <button class="chip @(_sort == VetoGanttSort.Source ? "chip--on" : null)" type="button"
                        data-testid="sort-source" @onclick="() => _sort = VetoGanttSort.Source">
                    As supplied
                </button>
                <button class="chip @(_sort == VetoGanttSort.Name ? "chip--on" : null)" type="button"
                        data-testid="sort-name" @onclick="() => _sort = VetoGanttSort.Name">
                    Alphabetical
                </button>
                <button class="chip @(_sort == VetoGanttSort.Start ? "chip--on" : null)" type="button"
                        data-testid="sort-start" @onclick="() => _sort = VetoGanttSort.Start">
                    By start date
                </button>
            </VetoStack>

            <span class="demo-value" data-testid="change-note">@(_change ?? "Drag a bar, or focus one and press an arrow key.")</span>
        </VetoStack>
    </DemoBlock>

    <DemoBlock TestId="demo-loading"
               Title="Waiting for data"
               Description="Two different waits. Before anything has arrived, Loading draws a placeholder chart that holds the layout, so nothing jumps when the rows land. Once there are rows on screen, Refreshing veils them instead - replacing what someone is reading with grey boxes takes away what they had."
               Code="@LoadingCode">
        <VetoStack Gap="VetoSpacing.Medium">
            <VetoStack Orientation="VetoOrientation.Horizontal" Gap="VetoSpacing.Small" Wrap="true">
                <VetoButton Size="VetoSize.Small" Variant="VetoVariant.Outlined" Color="VetoColor.Neutral"
                            TestId="load-first" OnClick="FirstLoadAsync">
                    First load
                </VetoButton>
                <VetoButton Size="VetoSize.Small" Variant="VetoVariant.Outlined" Color="VetoColor.Neutral"
                            TestId="load-refresh" OnClick="RefreshAsync">
                    Refresh
                </VetoButton>
            </VetoStack>

            <VetoGantt TestId="loader" View="VetoGanttView.Schedule"
                       Items="Chain"
                       TodayOverride="Today"
                       Loading="_loading"
                       Refreshing="_refreshing"
                       ShowToolbar="false"
                       SidebarWidth="12rem"
                       Height="15rem"
                       LoadingRows="4"
                       ScrollToTodayOnLoad="false" />
        </VetoStack>
    </DemoBlock>

    <DemoBlock TestId="demo-empty"
               Title="Nothing to show"
               Description="A filter that matches nothing says so, rather than leaving an empty panel that looks broken."
               Code="@EmptyCode">
        <VetoGantt TestId="empty" View="VetoGanttView.Schedule"
                   Items="Tasks"
                   TodayOverride="Today"
                   Search="a task that does not exist"
                   ShowToolbar="false"
                   Height="9rem"
                   ScrollToTodayOnLoad="false" />
    </DemoBlock>

    <VetoStack Gap="VetoSpacing.Medium">
        <h2 class="docs-heading">Export</h2>
        <p class="docs-prose">
            The formats live behind one export menu rather than a button each: the toolbar is
            already carrying filters, a zoom picker and date navigation, and export is the
            control a reader wants least often. It opens on hover by default - a click and the
            keyboard open it too - so it costs a single button of room until it is needed. Set
            <code>ExportOpenOn</code>, <code>ExportAppearance</code> and
            <code>ShowExportLabel</code> to trade that room differently.
        </p>
        <p class="docs-prose">
            Either format downloads what is <em>currently filtered</em> - what the reader can
            see, which is almost always what they meant. Dates are written as
            <code>yyyy-MM-dd</code> rather than in the display format, so a spreadsheet in
            another locale reads them as the same days.
        </p>
        <p class="docs-prose">
            <code>OnExport</code> fires first. Set <code>Handled</code> on the request and the
            component steps aside, leaving you the filtered rows to send to a server or turn
            into a format it does not produce.
        </p>
        <VetoCode Code="@ExportCode" Language="csharp" TestId="export-code" />
    </VetoStack>

    <ParameterTable Title="Parameters" TestId="parameters" Rows="Parameters" />
    <ParameterTable Title="Methods (through @@ref)" TestId="methods" Rows="Methods" />
    <ParameterTable Title="VetoGanttItem" TestId="item-parameters" Rows="ItemRows" />

</DocsPage>

@code {
    private VetoGanttScale _scale = VetoGanttScale.Day;
    private string? _selectedId;
    private string? _chainSelection;
    private VetoGanttView _todayView = VetoGanttView.Today;
    private VetoGantt _filtered = default!;
    private IReadOnlyCollection<string> _hidden = [];
    private IReadOnlyCollection<string> _active = [];
    private string _filterState = "No filter changed yet.";

    private static readonly VetoGanttScale[] DayOnly = [VetoGanttScale.Day];
    private static readonly VetoGanttExportFormat[] CsvOnly = [VetoGanttExportFormat.Csv];

    // Two toggles of the page's own, alongside the chart's category filter.
    private static readonly IReadOnlyList<VetoGanttFilter> TaskFilters =
    [
        new("underway", "Under way", item => item.Progress is > 0 and < 1) { Tooltip = "Started, not finished" },
        new("unstarted", "Not started", item => item.Progress is null or 0)
    ];

    private void OnFilterChanged ( VetoGanttFilterState state )
    {
        var active = state.ActiveFilters.Count == 0 ? "none" : string.Join(", ", state.ActiveFilters);
        var hidden = state.HiddenCategories.Count == 0 ? "none" : string.Join(", ", state.HiddenCategories);

        _filterState = $"Filters: {active} · Hidden: {hidden} · {state.VisibleItems.Count} rows";
    }
    private VetoGantt _driven = default!;
    private string? _drivenSelection;
    private VetoGanttScale _drivenScale = VetoGanttScale.Day;
    private string? _exportNote;
    private bool _loading;
    private bool _refreshing;
    private string? _change;
    private VetoGanttSort _sort = VetoGanttSort.Source;

    private void OnChanged ( VetoGanttChange change )
        => _change = $"{change.Id}: {change.Edit} by {change.Days} days — now {change.Start:d MMM} to {change.End:d MMM}";

    /// <summary>Stands in for a first fetch, where there is nothing on screen to keep.</summary>
    private async Task FirstLoadAsync ()
    {
        _loading = true;
        await Task.Delay(2200);
        _loading = false;
    }

    /// <summary>Stands in for a refresh, where the rows already on screen should stay put.</summary>
    private async Task RefreshAsync ()
    {
        _refreshing = true;
        await Task.Delay(2200);
        _refreshing = false;
    }

    // Fixed rather than relative to the real date, so the demo and its screenshots stay stable.
    private static readonly DateOnly Today = new(2026, 3, 18);

    private Task OnExport ( VetoGanttExportRequest request )
    {
        _exportNote = $"Exported {request.Items.Count} rows as {request.Format}.";
        return Task.CompletedTask;
    }

    // Colours are per category, so the filter chips above the chart read as a key to the bars.
    private const string Engineering = "var(--veto-color-primary)";
    private const string Design = "var(--veto-color-secondary)";
    private const string Research = "var(--veto-color-warning)";
    private const string Marketing = "var(--veto-color-success)";

    private static readonly IReadOnlyList<VetoGanttItem> Tasks =
    [
        new() { Id = "platform", Name = "Platform", Start = new(2026, 3, 2), End = new(2026, 4, 10), Category = "Engineering", Color = Engineering, Progress = 0.55 },
        new() { Id = "design", Name = "Design system", ParentId = "platform", Start = new(2026, 3, 2), End = new(2026, 3, 13), Category = "Design", Color = Design, Progress = 1 },
        new() { Id = "shell", Name = "App shell", ParentId = "platform", Start = new(2026, 3, 9), End = new(2026, 3, 24), Category = "Engineering", Color = Engineering, Progress = 0.8, DependsOn = ["design"] },
        new() { Id = "components", Name = "Component library", ParentId = "platform", Start = new(2026, 3, 16), End = new(2026, 4, 10), Category = "Engineering", Color = Engineering, Progress = 0.35, DependsOn = ["design"] },

        new() { Id = "mobile", Name = "Mobile", Start = new(2026, 3, 23), End = new(2026, 4, 24), Category = "Engineering", Color = Engineering, Progress = 0.1 },
        new() { Id = "spike", Name = "Feasibility spike", ParentId = "mobile", Start = new(2026, 3, 23), End = new(2026, 3, 27), Category = "Research", Color = Research, Progress = 0.6 },
        new() { Id = "build", Name = "Build", ParentId = "mobile", Start = new(2026, 3, 30), End = new(2026, 4, 24), Category = "Engineering", Color = Engineering, DependsOn = ["spike", "shell"] },

        new() { Id = "launch", Name = "Launch", Start = new(2026, 4, 13), End = new(2026, 5, 1), Category = "Marketing", Color = Marketing, Progress = 0 },
        new() { Id = "copy", Name = "Write the copy", ParentId = "launch", Start = new(2026, 4, 13), End = new(2026, 4, 22), Category = "Marketing", Color = Marketing, DependsOn = ["components"] },
        new() { Id = "ship", Name = "Ship", ParentId = "launch", Start = new(2026, 5, 1), End = new(2026, 5, 1), Category = "Marketing", Color = Marketing, IsMilestone = true, DependsOn = ["build", "copy"] }
    ];

    private static readonly IReadOnlyList<VetoGanttItem> Milestones =
    [
        new() { Id = "a", Name = "Discovery", Start = new(2026, 3, 2), End = new(2026, 3, 20), Color = "var(--veto-color-success)", Progress = 1 },
        new() { Id = "b", Name = "Alpha", Start = new(2026, 3, 20), End = new(2026, 3, 20), IsMilestone = true, Color = "var(--veto-color-warning)" },
        new() { Id = "c", Name = "Hardening", Start = new(2026, 3, 23), End = new(2026, 4, 17), Color = "var(--veto-color-secondary)", Progress = 0.4 },
        new() { Id = "d", Name = "Release", Start = new(2026, 4, 17), End = new(2026, 4, 17), IsMilestone = true, Color = "var(--veto-color-danger)" }
    ];

    // Deliberately not in alphabetical order, so the ordering toggle visibly does something.
    private static readonly IReadOnlyList<VetoGanttItem> Editable =
    [
        new() { Id = "wiring", Name = "Wiring", Start = new(2026, 3, 9), End = new(2026, 3, 17), Color = Engineering, Progress = 0.7 },
        new() { Id = "audit", Name = "Audit", Start = new(2026, 3, 4), End = new(2026, 3, 10), Color = Research, Progress = 1 },
        new() { Id = "rollout", Name = "Rollout", Start = new(2026, 3, 20), End = new(2026, 3, 31), Color = Marketing },
        new() { Id = "design", Name = "Blueprint", Start = new(2026, 3, 2), End = new(2026, 3, 6), Color = Design, Progress = 1 }
    ];

    private static readonly IReadOnlyList<VetoGanttItem> Chain =
    [
        new() { Id = "survey", Name = "Survey", Start = new(2026, 3, 2), End = new(2026, 3, 6), Progress = 1 },
        new() { Id = "draft", Name = "Draft", Start = new(2026, 3, 9), End = new(2026, 3, 17), DependsOn = ["survey"], Progress = 0.5 },
        new() { Id = "review", Name = "Review", Start = new(2026, 3, 18), End = new(2026, 3, 24), DependsOn = ["draft"] },
        // Starts before Review finishes: the arrow routes back rather than cutting through.
        new() { Id = "publish", Name = "Publish", Start = new(2026, 3, 20), End = new(2026, 3, 26), DependsOn = ["review"] }
    ];

    // A day of timed jobs on 18 March - the demo's today - plus one either side of it, which the
    // today view must leave out.
    private static readonly IReadOnlyList<VetoGanttItem> Jobs =
    [
        new() { Id = "ops", Name = "Operations", Start = new(2026, 3, 18), End = new(2026, 3, 18), StartTime = new(6, 0), EndTime = new(21, 0), Category = "Engineering", Color = Engineering },
        new() { Id = "etl", Name = "Data load", ParentId = "ops", Start = new(2026, 3, 18), End = new(2026, 3, 18), StartTime = new(6, 0), EndTime = new(8, 30), Category = "Engineering", Color = Engineering },
        new() { Id = "reports", Name = "Reports", ParentId = "ops", Start = new(2026, 3, 18), End = new(2026, 3, 18), StartTime = new(9, 0), EndTime = new(10, 0), Category = "Research", Color = Research },
        new() { Id = "deploy", Name = "Deploy", ParentId = "ops", Start = new(2026, 3, 18), End = new(2026, 3, 18), StartTime = new(14, 0), EndTime = new(15, 30), Category = "Engineering", Color = Engineering },
