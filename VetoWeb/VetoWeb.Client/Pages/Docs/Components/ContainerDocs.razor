@page "/docs/components/container"
@rendermode InteractiveWebAssembly

<PageTitle>Container — Veto</PageTitle>

<DocsPage Eyebrow="Components"
          Title="Container"
          Lead="Constrains content to a comfortable reading width and centres it. This page is inside one.">

    <DemoBlock TestId="demo-sizes"
               Title="Sizes"
               Description="Five widths. Medium is around 48rem, which keeps a line of prose near the 70-character mark that is comfortable to read."
               Code="@SizesCode">
        <VetoStack Gap="VetoSpacing.Medium">
            <VetoContainer Size="VetoContainerSize.Small" TestId="small" Class="container-demo">Small · 30rem</VetoContainer>
            <VetoContainer Size="VetoContainerSize.Medium" TestId="medium" Class="container-demo">Medium · 48rem</VetoContainer>
            <VetoContainer Size="VetoContainerSize.Large" TestId="large" Class="container-demo">Large · 64rem</VetoContainer>
            <VetoContainer Size="VetoContainerSize.ExtraLarge" Class="container-demo">Extra large · 80rem</VetoContainer>
            <VetoContainer Size="VetoContainerSize.Full" Class="container-demo">Full · no limit</VetoContainer>
        </VetoStack>
    </DemoBlock>

    <DemoBlock TestId="demo-padding"
               Title="Padding"
               Description="Horizontal padding keeps content off the viewport edge on small screens. It applies even at Full width, where there is no maximum."
               Code="@PaddingCode">
        <VetoContainer Size="VetoContainerSize.Small" Padding="VetoSpacing.Huge" TestId="padded" Class="container-demo">
            Roomier padding
        </VetoContainer>
    </DemoBlock>

    <ParameterTable TestId="parameters" Rows="Parameters" />

</DocsPage>

@code {
    private static readonly ParameterTable.Row[] Parameters =
    [
        new("Size", "VetoContainerSize", "Medium", "Small 30rem, Medium 48rem, Large 64rem, ExtraLarge 80rem, or Full."),
        new("Padding", "VetoSpacing", "Large", "Horizontal padding, from the spacing scale."),
        new("Centered", "bool", "true", "Whether the container is centred in the space available.")
    ];

    private const string SizesCode = """
        <VetoContainer Size="VetoContainerSize.Small">30rem</VetoContainer>
        <VetoContainer Size="VetoContainerSize.Large">64rem</VetoContainer>
        <VetoContainer Size="VetoContainerSize.Full">No limit</VetoContainer>
        """;

    private const string PaddingCode = """
        <VetoContainer Size="VetoContainerSize.Small" Padding="VetoSpacing.Huge">
            Roomier padding
        </VetoContainer>
        """;
}
